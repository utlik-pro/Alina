# Telegram Bot Token (получить у @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-mini

# Telegram Admin Group для уведомлений
ADMIN_GROUP_CHAT_ID=-100xxxxxxxxxx

# Database (PostgreSQL recommended for production)
# SQLite for development:
DATABASE_URL=sqlite+aiosqlite:///./crystal_lab.db
# PostgreSQL for production:
# DATABASE_URL=postgresql+asyncpg://crystal_lab:password@localhost:5432/crystal_lab

# Redis (for message buffering; optional — falls back to in-memory)
# REDIS_URL=redis://localhost:6379/0

# Режим отладки
DEBUG=True
LOG_LEVEL=INFO

# Настройки агента
RESPONSE_TIMEOUT=30
MAX_RETRIES=3

# WhatsApp Business Cloud API
# Получить в Meta Business Suite: https://business.facebook.com/
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=crystal_lab_verify_2026
WHATSAPP_APP_SECRET=your_app_secret
WHATSAPP_WEBHOOK_PORT=8000

# YClients API
# Получить partner token: https://support.yclients.com/67-68-199--dostup-k-api/
YCLIENTS_PARTNER_TOKEN=your_partner_token
YCLIENTS_USER_TOKEN=your_user_token
YCLIENTS_COMPANY_ID=your_company_id
YCLIENTS_LOGIN=your_login
YCLIENTS_PASSWORD=your_password

# Mock режимы (для MVP без интеграций)
MOCK_YCLIENTS=True
MOCK_WHATSAPP=True

# ── Instagram entry point (IG DM → qualify → WhatsApp CTA) ──
# Meta app with Instagram messaging; token + app secret from Meta Business Suite
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_VERIFY_TOKEN=crystal_lab_ig_2026
INSTAGRAM_APP_SECRET=
# WhatsApp number prospects are funneled to (digits only, e.g. 9715XXXXXXXX)
WHATSAPP_CTA_NUMBER=

# ── Driver / logistics notifications ──
# Telegram chat id of the driver/logistics group ("share with driver")
DRIVER_TELEGRAM_CHAT_ID=

# ── Payments ──
# Bank details shown to clients paying by transfer (free text, multi-line ok)
PAYMENT_BANK_DETAILS=
# Optional online-payment provider base URL (Stripe/Telr/etc.) — stub for now
PAYMENT_LINK_BASE=
# Same-day / no-show transportation penalty in AED (FR-5.2)
TRANSPORTATION_PENALTY_AED=50
