# Telegram Bot Token (получить у @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Telegram Admin Group для уведомлений
ADMIN_GROUP_CHAT_ID=-100xxxxxxxxxx

# Database
DATABASE_URL=sqlite+aiosqlite:///./crystal_lab.db

# Режим отладки
DEBUG=True
LOG_LEVEL=INFO

# Настройки агента
RESPONSE_TIMEOUT=30
MAX_RETRIES=3

# WhatsApp Business Cloud API
# Получить в Meta Business Suite: https://business.facebook.com/
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=crystal_lab_verify_2026
WHATSAPP_APP_SECRET=your_app_secret
WHATSAPP_WEBHOOK_PORT=8000

# YClients API
# Получить partner token: https://support.yclients.com/67-68-199--dostup-k-api/
YCLIENTS_PARTNER_TOKEN=your_partner_token
YCLIENTS_USER_TOKEN=your_user_token
YCLIENTS_COMPANY_ID=your_company_id
YCLIENTS_LOGIN=your_login
YCLIENTS_PASSWORD=your_password

# Mock режимы (для MVP без интеграций)
MOCK_YCLIENTS=True
MOCK_WHATSAPP=True
